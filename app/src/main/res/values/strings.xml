    <!-- Permissions checklist -->
    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro">FocusLock needs a few permissions to keep an eye on your limits. Everything stays on your device; nothing is ever sent anywhere.</string>
    <string name="permissions_summary">%1$d of %2$d granted</string>
    <string name="permissions_footer">Usage access and notifications are needed to start tracking. The other two are needed to lock an app once its limit is reached.</string>
    <string name="perm_granted">Granted</string>
    <string name="perm_missing">Missing</string>
    <string name="perm_tag_tracking">Needed for tracking</string>
    <string name="perm_tag_blocking">Needed for blocking</string>
    <string name="perm_button_open_settings">Open settings</string>
    <string name="perm_button_allow">Allow</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_why">Lets FocusLock see how long each app is open, so it can count your time.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_why">Lets FocusLock show its lock screen on top of an app once you reach its limit.</string>
    <string name="perm_accessibility_title">Accessibility</string>
    <string name="perm_accessibility_why">Lets FocusLock notice which app is on screen and send you home when that app is locked.</string>
    <string name="perm_accessibility_hint">If the switch is greyed out: open FocusLock\'s App info, tap the ⋮ menu and choose “Allow restricted settings”.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_why">Shows a small, quiet notification while FocusLock keeps tracking in the background.</string>

