<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Special access: the user grants it in Settings > Usage access (there is no runtime dialog).
        Needed to measure how long each app is in the foreground. Lint flags it as a protected
        permission because only the system may grant it; declaring it is what makes FocusLock
        appear in that Settings list.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        "Display over other apps": what allows the lock screen to be started from the background, on top of
        a blocked app (Android 10+ otherwise refuses activity starts from a service).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The always-on tracking service and its (special use) type, required on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Runtime permission on Android 13+: shows the service's persistent notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart tracking after the phone reboots (Phase 6). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notably absent: INTERNET. FocusLock is local-only by design. -->

    <!--
        Package visibility (Android 11+): lets PackageManager see every app that has a
        launcher entry, which is exactly the set of apps a user can meaningfully block.
        This avoids the broad QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home screens too, so the blocker can recognise them and never lock the user out of Home. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".FocusLockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusLock">

        <!--
            singleTask: the lock screen and the "App locked" notification open the edit screen of a locked
            app; a running instance must receive that as a new intent instead of stacking a second one.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FocusLock"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The "Locked for today" page. Its own task (singleInstance + empty affinity) so it never sits inside
            the blocked app's task, and out of Recents so it can't be resumed from the app switcher. Not exported:
            only FocusLock's own blocker starts it.
        -->
        <activity
            android:name=".ui.lock.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusLock" />

        <!-- Tracks foreground time of the limited apps. Not exported: only FocusLock starts it. -->
        <service
            android:name=".service.FocusLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required with specialUse: says what this service is for (shown in Play's review). -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Measures, on the device only, how long apps chosen by the user are in the foreground so that the daily time limits the user set can be enforced." />
        </service>

        <!--
            Detects a locked app coming to the front and sends the user home (see the class). The system
            itself (not other apps) binds to it, hence the permission; the user switches it on in Settings.
        -->
        <service
            android:name=".service.FocusLockAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
